{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/detect-changes.py\"",
            "timeout": 30,
            "statusMessage": "Detect Changes - Erixcel"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/validate-query.py\"",
            "timeout": 45,
            "statusMessage": "Query Validator - Erixcel"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/validate-core.py\"",
            "timeout": 45,
            "statusMessage": "Core Validator - Erixcel"
          }
        ]
      }
    ]
  }
}
